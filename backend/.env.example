# "gemini" (default) or "openai" for any OpenAI-compatible API (OpenAI, Groq, Ollama)
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# flash-lite answers in about a second; the fallbacks are tried in order if it is busy
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Give up on a model that hasn't answered after this many seconds and try the next one
LLM_TIMEOUT_SECONDS=45
# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Database: Postgres with pgvector. `docker compose up -d` in the project root starts one.
DATABASE_URL=postgresql+psycopg://paperlens:paperlens@localhost:5433/paperlens

# Accounts
SESSION_DAYS=30
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
MAX_PAPERS_PER_USER=100

# Retrieval
USE_EMBEDDINGS=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model's vector size (bge-small = 384)
EMBEDDING_DIM=384
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6

# Papers longer than this (characters) are summarised in parts
SUMMARY_MAX_CHARS=120000

MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173