# "gemini" (default) or "openai" for any OpenAI-compatible API (OpenAI, Groq, Ollama)
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Retrieval
USE_EMBEDDINGS=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6

# Papers longer than this (characters) are summarised in parts
SUMMARY_MAX_CHARS=120000

MAX_UPLOAD_MB=25
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173